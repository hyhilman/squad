// browser (router, query cache, the CSP nonce in the meta tag the server adds to <head>).
import App from "../app/App.tsx";
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>squad</title>
  </head>
  <body>
    <App client:only="react" />
  </body>
</html>
