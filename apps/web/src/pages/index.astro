---
// The one page. The whole app is a single React island that renders on the client only: it needs the
// browser (router, query cache, the CSP nonce in the meta tag the server adds to <head>).
import App from "../app/App.tsx";
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>squad</title>
    <link rel="icon" href="/brand/favicon.ico" sizes="any" />
    <link rel="apple-touch-icon" href="/brand/apple-touch-icon.png" />
  </head>
  <body>
    <App client:only="react" />
  </body>
</html>
